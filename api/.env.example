# ─────────────────────────────────────────────────────────────
# Fable API — environment variables
# Copy to `.env` (never commit .env) and fill in what you have.
# The MVP runs with ZERO keys set — Shield returns full risk scores and
# signals, and explanations fall back to a deterministic local template.
# Add an AI key below to get real LLM-generated explanations.
# ─────────────────────────────────────────────────────────────

# --- AI explanation providers (optional) ---
# Fable tries Anthropic first, then OpenAI, then the local template.
# Set EITHER of these (or both) for real AI explanations.

# Anthropic Claude (preferred). Get one at https://console.anthropic.com
ANTHROPIC_API_KEY=
# Override the model if you want a cheaper/faster tier (e.g. claude-sonnet-5,
# claude-haiku-4-5). Defaults to claude-opus-4-8.
ANTHROPIC_MODEL=claude-opus-4-8

# OpenAI GPT-4o (fallback). Get one at https://platform.openai.com
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# --- Runtime ---
ENVIRONMENT=development
# Optional: override the SQLite file location. Defaults to api/fable.db
FABLE_DB_PATH=

# --- Security / ops (all optional; safe demo defaults) ---
# Comma-separated API keys. If set, protected endpoints require
# `Authorization: Bearer <key>` (or `X-API-Key`). Leave blank for open demo mode.
FABLE_API_KEYS=
# Per-client rate limit: max requests per window (seconds). Generous by default.
FABLE_RATE_LIMIT_MAX=180
FABLE_RATE_LIMIT_WINDOW=60
# CORS: "*" for the demo, or a comma-separated list of allowed origins in prod
# e.g. https://your-demo-bank.vercel.app,https://your-dashboard.vercel.app
FABLE_CORS_ORIGINS=*
# Optional Sentry error monitoring (leave blank to disable).
SENTRY_DSN=
# Frontend origin, used in provisioning emails and links.
FRONTEND_URL=http://localhost:3000

# --- Verification: email OTP + passkeys (all optional) ---
# SMTP for out-of-band verification codes. With none set, the code is shown
# in the response as a debug fallback so the flow stays testable.
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=Fable Provisioning <no-reply@fable.ng>
# WebAuthn passkeys. RP_ID must match the browser's host; origins is a
# comma-separated allowlist. Use your real domain in prod.
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGINS=http://localhost:3000,http://localhost:3001
# --- Customer PIN and verification rules ---
# These are your choices; the code does not decide them for you. The values
# shown are the defaults, so setting them changes nothing until you edit one.
# How many digits a transaction PIN has: 4 (what most banking apps use) or 6.
FABLE_PIN_LENGTH=4
# Wrong PIN attempts before the PIN locks, and for how many minutes.
FABLE_PIN_MAX_ATTEMPTS=5
FABLE_PIN_LOCKOUT_MINUTES=15
# true refuses repeated digits (0000) and plain runs (1234, 4321). Off by
# default: a customer can pick any PIN of the right length.
FABLE_PIN_BLOCK_WEAK=false
# How long a verification proof stays valid, and the one-time code limits.
FABLE_STEPUP_TOKEN_TTL_SECONDS=600
FABLE_OTP_TTL_SECONDS=600
FABLE_OTP_MAX_ATTEMPTS=5
# KYC/liveness provider for the strongest identity tier. Empty = the composed
# passkey+PIN+OTP substitute is used instead (never a faked face match).
KYC_PROVIDER_URL=

# ─────────────────────────────────────────────────────────────
# TUNING — Shield scoring, thresholds, Ghost, limits.
# ALL optional; the values below ARE the built-in defaults, so setting them
# changes nothing until you edit a number. Grounded in published NIBSS/CBN
# channel-fraud stats + Nigerian scam patterns; NOT a trained model.
# ─────────────────────────────────────────────────────────────

# --- Decision thresholds: the FLAG/BLOCK boundary ---
# Default cutoff, plus a per-channel override for each rail (riskier rails trip
# sooner). FABLE_THRESHOLD_<CHANNEL>_<BLOCK|FLAG>.
FABLE_BLOCK_THRESHOLD=0.80
FABLE_FLAG_THRESHOLD=0.50
FABLE_THRESHOLD_USSD_BLOCK=0.75
FABLE_THRESHOLD_USSD_FLAG=0.45
FABLE_THRESHOLD_INTERNET_BLOCK=0.75
FABLE_THRESHOLD_INTERNET_FLAG=0.45
FABLE_THRESHOLD_POS_BLOCK=0.78
FABLE_THRESHOLD_POS_FLAG=0.48
FABLE_THRESHOLD_ATM_BLOCK=0.78
FABLE_THRESHOLD_ATM_FLAG=0.48
FABLE_THRESHOLD_MOBILE_APP_BLOCK=0.80
FABLE_THRESHOLD_MOBILE_APP_FLAG=0.50
FABLE_THRESHOLD_QR_BLOCK=0.80
FABLE_THRESHOLD_QR_FLAG=0.50
FABLE_THRESHOLD_BRANCH_BLOCK=0.85
FABLE_THRESHOLD_BRANCH_FLAG=0.55

# --- Signal weights (FABLE_W_*): how much each signal adds to the score ---
# Amount anomaly, by multiple of the customer's own baseline
FABLE_W_AMOUNT_50X=0.40
FABLE_W_AMOUNT_25X=0.34
FABLE_W_AMOUNT_10X=0.28
FABLE_W_AMOUNT_5X=0.20
FABLE_W_AMOUNT_3X=0.15
# Recipient / timing
FABLE_W_NEW_RECIPIENT=0.20
FABLE_W_TIME_ANOMALY=0.12
FABLE_W_TIMEZONE_MISMATCH=0.08
# Device
FABLE_W_DEVICE_ANOMALY=0.08
FABLE_W_DEVICE_ANOMALY_LARGE=0.18
# Location (country change weighs far more than a new city)
FABLE_W_LOCATION_COUNTRY=0.22
FABLE_W_LOCATION_CITY=0.06
FABLE_W_LOCATION_CITY_LARGE=0.12
# Session / behaviour
FABLE_W_SESSION_FRESHNESS=0.12
FABLE_W_BEHAVIORAL_PASTE=0.06
FABLE_W_BEHAVIORAL_FAST=0.09
# Failed verification (recent fumbled step-ups)
FABLE_W_FAILED_VERIFICATION=0.08
FABLE_W_FAILED_VERIFICATION_LARGE=0.15
FABLE_W_FAILED_VERIFICATION_HIGH=0.25
# Velocity: a burst of transfers in a short window
FABLE_W_VELOCITY=0.10
FABLE_W_VELOCITY_HIGH=0.20
FABLE_VELOCITY_WINDOW_MIN=10
FABLE_VELOCITY_FLAG=3
FABLE_VELOCITY_HIGH=5

# --- Ghost cooling windows (minutes, by risk) ---
GHOST_COOLING_HIGH=15
GHOST_COOLING_MED=10
GHOST_COOLING_LOW=5

# --- Explainer timeout + top-up guards + branding limits ---
FABLE_EXPLAINER_TIMEOUT=10
TOPUP_MAX_AMOUNT=500000
TOPUP_DAILY_MAX=1000000
TOPUP_DAILY_COUNT=5
BRANDING_SLUG_LOCK_DAYS=7
BRANDING_MAX_LOGO_BYTES=512000

# ─────────────────────────────────────────────────────────────
# Production scale-out (NOT used by the current demo build — documented here so
# the deployment story is clear). The MVP uses local SQLite instead of
# Supabase, and no Redis. Wire these when moving past the demo:
# ─────────────────────────────────────────────────────────────
# SUPABASE_URL=
# SUPABASE_KEY=
# UPSTASH_REDIS_URL=
# UPSTASH_REDIS_TOKEN=
# GEMINI_API_KEY=          # document/image analysis for deepfake checks
