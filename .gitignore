# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# The templates carry no secrets and the setup docs tell people to copy them.
!.env.example
!.env.local.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# Local SQLite database (regenerated via `pnpm db:setup`)
*.db
*.db-wal
*.db-shm
*.db-journal
*.db-journal

# Python and AI tools
/api/.venv
/api/venv
__pycache__/
*.pyc
/.claude

# Local DO deployment cheatsheet
.local/
